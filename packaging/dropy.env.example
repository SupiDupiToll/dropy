# dropy configuration
# Copy to /etc/dropy/dropy.env and adjust.

DROPY_LISTEN=127.0.0.1:8080
DROPY_DATA_DIR=/var/lib/dropy

DROPY_ADMIN_HOST=admin.example.com
DROPY_PAGES_HOST=pages.example.com
DROPY_ADMIN_BASE_URL=https://admin.example.com
DROPY_PUBLIC_BASE_URL=https://pages.example.com

# --- Admin login: Pocket-ID application #1 -------------------------------
# Callback URL in Pocket-ID: https://admin.example.com/auth/callback
DROPY_ADMIN_OIDC_ISSUER=https://id.example.com
DROPY_ADMIN_OIDC_CLIENT_ID=
DROPY_ADMIN_OIDC_CLIENT_SECRET=
DROPY_ADMIN_OIDC_REDIRECT_URL=https://admin.example.com/auth/callback

# Optional extra allowlist. Empty = trust the Pocket-ID application config.
# DROPY_ADMIN_EMAILS=you@example.com
# DROPY_ADMIN_GROUPS=admins

# --- Pages login: separate Pocket-ID application #2 ----------------------
# Callback URL in Pocket-ID: https://pages.example.com/__auth/callback
# Users allowed in this Pocket-ID application may open any Pocket-ID
# protected dropy page.
DROPY_PAGES_OIDC_ISSUER=https://id.example.com
DROPY_PAGES_OIDC_CLIENT_ID=
DROPY_PAGES_OIDC_CLIENT_SECRET=
DROPY_PAGES_OIDC_REDIRECT_URL=https://pages.example.com/__auth/callback

# Optional extra allowlist for Pocket-ID protected pages.
# DROPY_PAGES_EMAILS=
# DROPY_PAGES_GROUPS=

# Requested scopes (add "groups" if you use group allowlists).
DROPY_OIDC_SCOPES=openid profile email

# --- Behaviour ------------------------------------------------------------
DROPY_SECURE_COOKIES=true
DROPY_TRUST_PROXY=true
DROPY_ENABLE_MULTI_FILE=false
DROPY_KEEP_VERSIONS=10
DROPY_SESSION_DAYS=30
DROPY_PAGE_SESSION_HOURS=24

# Upload limits (bytes unless noted)
DROPY_MAX_HTML_BYTES=5242880
DROPY_MAX_ZIP_BYTES=52428800
DROPY_MAX_FILE_BYTES=10485760
DROPY_MAX_FILES=200

# Development only. Never enable on the public server.
DROPY_DEV=false
DROPY_DEV_AUTH=false
